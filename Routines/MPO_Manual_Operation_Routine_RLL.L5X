<Routines Use="Context">
<Routine Use="Target" Name="MPO_Manual_Operation" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[MPO turntable clockwise]]>
</Comment>
<Text>
