<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(GripperTimers[0].DN)[MOVE(30,Step[1]) ,RES(GripperTimers[0]) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
