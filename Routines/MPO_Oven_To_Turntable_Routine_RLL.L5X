</Text>
</Rung>
<Rung Number="28" Type="N">
<Text>
<![CDATA[XIC(Local:3:I.Data.0)[MOVE(60,Step[1]) ,OTU(Local:6:O.Data.7) ];]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Text>
