<Routines Use="Context">
<Routine Use="Target" Name="MPO_Oven_To_Turntable" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[EQ(0,Step[1])JMP(Gripper_Idle);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[EQ(10,Step[1])JMP(Gripper_Move_To_Oven);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[EQ(20,Step[1])JMP(Gripper_Oven_Lower);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[EQ(30,Step[1])JMP(Gripper_Grab);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[EQ(40,Step[1])JMP(Gripper_Oven_Raise);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[EQ(50,Step[1])JMP(Gripper_Move_To_Turntable);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[EQ(60,Step[1])JMP(Gripper_Turntable_Lower);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[EQ(70,Step[1])JMP(Gripper_Place);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[EQ(80,Step[1])JMP(Gripper_Turntable_Raise);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Gripper Idle]]>
</Comment>
<Text>
<![CDATA[LBL(Gripper_Idle)XIC(MPO_Gripper_Start)MOVE(10,Step[1]);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[RET();]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Gripper move to oven position]]>
</Comment>
<Text>
<![CDATA[LBL(Gripper_Move_To_Oven)[OTL(Local:7:O.Data.9) ,PWM_Out(PWM_Outputs[4],Local:7:O.Data.21,100,500) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[OTU(MPO_Gripper_Start);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(Local:3:I.Data.3)[MOVE(20,Step[1]) ,OTU(Local:7:O.Data.9) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[JMP(Gripper_Idle);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Gripper in oven position lower]]>
</Comment>
<Text>
<![CDATA[LBL(Gripper_Oven_Lower)OTL(Local:6:O.Data.27);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[TON(GripperTimers[0],?,?);]]>
</Text>
