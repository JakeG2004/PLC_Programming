<Routines Use="Context">
<Routine Use="Target" Name="MPO_Homing" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Gripper Homing]]>
</Comment>
<Text>
<![CDATA[XIO(Local:3:I.Data.0)[OTL(Local:6:O.Data.7) ,PWM_Out(PWM_Outputs[9],Local:7:O.Data.21,100,500) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Local:3:I.Data.0)OTU(Local:6:O.Data.7);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Turntable Homing]]>
</Comment>
<Text>
<![CDATA[XIO(Local:2:I.Data.12)[OTL(Local:6:O.Data.22) ,PWM_Out(PWM_Outputs[10],Local:6:O.Data.6,100,500) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Local:2:I.Data.12)OTU(Local:6:O.Data.22);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(Local:3:I.Data.0)XIC(Local:2:I.Data.12)OTU(MPO_Homing);]]>
</Text>
</Rung>
