</Tag>
</Tags>
<Routines Use="Context">
<Routine Use="Target" Name="MPO_Turntable_Process" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[EQ(0,Step[2])JMP(Turntable_Idle);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[EQ(10,Step[2])JMP(Turntable_Turn_To_Saw);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[EQ(20,Step[2])JMP(Turntable_Saw_On);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[EQ(30,Step[2])JMP(Turntable_Saw_Off);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[EQ(40,Step[2])JMP(Turntable_Turn_To_Conveyor);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[EQ(50,Step[2])JMP(Turntable_Pusher_On);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[EQ(60,Step[2])JMP(Turntable_Pusher_Off);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[EQ(70,Step[2])JMP(Turntable_Return_and_Conveyor_On);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Turntable idle]]>
</Comment>
<Text>
<![CDATA[LBL(Turntable_Idle)XIC(MPO_Turntable_Start)MOVE(10,Step[2]);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[RET();]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Turntable turn to saw position]]>
</Comment>
<Text>
<![CDATA[LBL(Turntable_Turn_To_Saw)[OTL(Local:6:O.Data.21) ,PWM_Out(PWM_Outputs[6],Local:6:O.Data.6,100,500) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[OTU(MPO_Turntable_Start);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(Local:2:I.Data.15)[MOVE(20,Step[2]) ,OTU(Local:6:O.Data.21) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[JMP(Turntable_Idle);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Turntable saw on]]>
</Comment>
<Text>
<![CDATA[LBL(Turntable_Saw_On)OTL(Local:7:O.Data.7);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[TON(TurntableTimers[0],?,?);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIC(TurntableTimers[0].DN)[MOVE(30,Step[2]) ,RES(TurntableTimers[0]) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[JMP(Turntable_Idle);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Turntable saw off]]>
</Comment>
<Text>
<![CDATA[LBL(Turntable_Saw_Off)[MOVE(40,Step[2]) ,OTU(Local:7:O.Data.7) ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[JMP(Turntable_Idle);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[Turntable turn to conveyor]]>
</Comment>
<Text>
<![CDATA[LBL(Turntable_Turn_To_Conveyor)[OTL(Local:6:O.Data.21) ,PWM_Out(PWM_Outputs[7],Local:6:O.Data.6,100,500) ];]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[XIC(Local:2:I.Data.13)[MOVE(50,Step[2]) ,OTU(Local:6:O.Data.21) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[JMP(Turntable_Idle);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[Turntable pusher extend]]>
</Comment>
<Text>
<![CDATA[LBL(Turntable_Pusher_On)OTL(Local:6:O.Data.9);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[TON(TurntableTimers[1],?,?);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Text>
<![CDATA[XIC(TurntableTimers[1].DN)[MOVE(60,Step[2]) ,RES(TurntableTimers[1]) ];]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Text>
<![CDATA[JMP(Turntable_Idle);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[Turntable pusher retract]]>
</Comment>
<Text>
<![CDATA[LBL(Turntable_Pusher_Off)OTU(Local:6:O.Data.9);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Text>
<![CDATA[MOVE(70,Step[2]);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Text>
<![CDATA[JMP(Turntable_Idle);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Comment>
<![CDATA[Turntable return table to vacuum position and move conveyor to light barrier]]>
</Comment>
<Text>
<![CDATA[LBL(Turntable_Return_and_Conveyor_On)[[OTL(Local:6:O.Data.22) ,PWM_Out(PWM_Outputs[8],Local:6:O.Data.6,100,500) ] ,OTL(Local:6:O.Data.23) ];]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Text>
<![CDATA[XIO(Local:2:I.Data.14)OTU(Local:6:O.Data.23);]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Text>
<![CDATA[XIC(Local:2:I.Data.12)OTU(Local:6:O.Data.22);]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Text>
<![CDATA[XIO(Local:2:I.Data.14)XIC(Local:2:I.Data.12)[MOVE(0,Step[2]) ,OTL(MPO_Done) ];]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Text>
<![CDATA[JMP(Turntable_Idle);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
</Controller>
</RSLogix5000Content>
