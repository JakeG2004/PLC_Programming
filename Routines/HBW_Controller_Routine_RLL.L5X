<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIO(PWM_Timer_Off.DN)TON(PWM_Timer_On,?,?);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(PWM_Timer_On.DN)TON(PWM_Timer_Off,?,?);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIO(PWM_Timer_On.DN)OTE(PWM_Pin);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Prescan" Type="RLL">
<Description>
<![CDATA[Perform Calculations for PWM Timing]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Clamp Inputs to valid range]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Interval notation
Duty_Cycle = [0,100]

]]>
</Comment>
<Text>
<![CDATA[[GT(Duty_Cycle,100) MOVE(100,Duty_Cycle) ,LT(Duty_Cycle,0) MOVE(0,Duty_Cycle) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Interval notation
Frequency_Hz = [0,1000]]]>
</Comment>
<Text>
<![CDATA[[GT(Frequency_Hz,1000) MOVE(1000,Frequency_Hz) ,LT(Frequency_Hz,0) MOVE(0,Frequency_Hz) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Start of PWM math calculations]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Calculate duty cycle scaler in range of  [0,1] for adjusting timer presets ]]>
</Comment>
<Text>
<![CDATA[DIV(Duty_Cycle,100,Duty_Cycle_Scaler);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Convert Frequency Hz to Frequency Ms(milliseconds) for timers]]>
</Comment>
<Text>
<![CDATA[CPT(Frequency_Ms,1000/(Frequency_Hz));]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[scale Frequency_Ms by our Duty_Cycle_Scaler  to obtain the time spent On component for PWM]]>
</Comment>
<Text>
<![CDATA[CPT(PWM_Timer_On.PRE,TRUNC((Frequency_Ms)*(Duty_Cycle_Scaler)));]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Calculate Remaining time which is Spent off ]]>
</Comment>
<Text>
<![CDATA[CPT(PWM_Timer_Off.PRE,TRUNC((Frequency_Ms)-(PWM_Timer_On.PRE)));]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
</AddOnInstructionDefinitions>
