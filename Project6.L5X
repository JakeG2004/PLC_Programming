<Routine Name="SLD_Controller" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Test SLD Motor M1conveyor belt]]>
</Comment>
<Text>
<![CDATA[XIC(SLD_start.0)OTE(Local:6:O.Data.14);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Test SLD Compressor]]>
</Comment>
<Text>
<![CDATA[XIC(SLD_start.1)OTE(Local:6:O.Data.15);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Test SLD Valve first ejector (white)]]>
</Comment>
<Text>
<![CDATA[XIC(SLD_start.2)OTE(Local:7:O.Data.0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Test SLD Valve second ejector (red)]]>
</Comment>
<Text>
<![CDATA[XIC(SLD_start.3)OTE(Local:7:O.Data.1);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Test SLD  Valve third ejector (blue)]]>
</Comment>
<Text>
<![CDATA[XIC(SLD_start.4)OTE(Local:7:O.Data.2);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="SLD_Sequencer" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[No Activity on SLD]]>
</Comment>
<Text>
<![CDATA[EQ(SLD_Step,0)OTU(SLD_start.0)OTU(SLD_start.1)OTU(SLD_start.2)OTU(SLD_start.3)OTU(SLD_start.4)JMP(Done);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Reset the SLD]]>
</Comment>
<Text>
<![CDATA[EQ(SLD_Step,10)RES(StepTimers[1])MOVE(SLD_Normal,SLD_Min_Value)MOVE(20,SLD_Step)JMP(Done);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Wait for new puck]]>
</Comment>
<Text>
<![CDATA[EQ(SLD_Step,20)JMP(Wait_For_Pucl);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Move the puck through the color detector
]]>
</Comment>
<Text>
<![CDATA[EQ(SLD_Step,30)JMP(Move_Puck_Through_Detector);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Determine the puck type]]>
</Comment>
<Text>
<![CDATA[EQ(SLD_Step,40)JMP(Determine_Puck_Type);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Move Puck To Destination]]>
</Comment>
<Text>
<![CDATA[EQ(SLD_Step,50)JMP(Move_Puck_To_Pusher);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Push Puck
]]>
</Comment>
<Text>
<![CDATA[EQ(SLD_Step,60)JMP(Push_Puck);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[LBL(Done)RET();]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[JMP(Done);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Wait For Puck]]>
</Comment>
<Text>
<![CDATA[LBL(Wait_For_Pucl)XIO(Local:2:I.Data.14)MOVE(30,SLD_Step);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[JMP(Done);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Responsible for deciding which color the puck is]]>
</Comment>
<Text>
<![CDATA[LBL(Move_Puck_Through_Detector)OTL(SLD_start.0);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[LT(Scaled_Analog_Color_Sensor_SLD,SLD_Min_Value)MOVE(Scaled_Analog_Color_Sensor_SLD,SLD_Min_Value);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIO(Local:3:I.Data.10)ADD(10,SLD_Step,SLD_Step);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[JMP(Done);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Responsible for deciding which color the puck is. Also resets the minimum value tracker]]>
</Comment>
<Text>
<![CDATA[LBL(Determine_Puck_Type)OTL(SLD_start.0)[LT(SLD_Min_Value,SLD_Red_Min) MOVE(SLD_White_Time,SLD_Move_Time) ,GT(SLD_Min_Value,SLD_Red_Min) LT(SLD_Min_Value,SLD_Blue_Min) MOVE(SLD_Red_Time,SLD_Move_Time) ,GT(SLD_Min_Value,SLD_Blue_Min) MOVE(SLD_Blue_Time,SLD_Move_Time) ]MOVE(SLD_Normal,SLD_Min_Value)ADD(SLD_Step,10,SLD_Step);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[JMP(Done);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[LBL(Move_Puck_To_Pusher)MOVE(SLD_Move_Time,StepTimers[1].PRE)TON(StepTimers[1],?,?);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIC(StepTimers[1].DN)OTU(SLD_start.0)RES(StepTimers[1])ADD(SLD_Step,10,SLD_Step);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[JMP(Done);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[Push Puck]]>
</Comment>
<Text>
<![CDATA[LBL(Push_Puck)[EQ(SLD_Move_Time,SLD_White_Time) OTL(SLD_start.2) ,EQ(SLD_Move_Time,SLD_Red_Time) OTL(SLD_start.3) ,EQ(SLD_Move_Time,SLD_Blue_Time) OTL(SLD_start.4) ]OTL(SLD_start.1);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[[EQ(SLD_Move_Time,SLD_White_Time) XIO(Local:3:I.Data.11) ,EQ(SLD_Move_Time,SLD_Red_Time) XIO(Local:3:I.Data.12) ,EQ(SLD_Move_Time,SLD_Blue_Time) XIO(Local:3:I.Data.13) ]OTU(SLD_start.0)OTU(SLD_start.1)OTU(SLD_start.2)OTU(SLD_start.3)OTU(SLD_start.4)MOVE(10,SLD_Step);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[JMP(Done);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="VGR_Controller" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Test VGR Motor M1 vertical axis up
]]>
</Comment>
<Text>
<![CDATA[XIC(VGR_start.0)OTE(Local:6:O.Data.10);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Test VGR Motor M1 vertical axis down
]]>
</Comment>
<Text>
<![CDATA[XIC(VGR_start.1)OTE(Local:6:O.Data.11);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Test VGR Motor M2 horizontal axis backward
]]>
</Comment>
<Text>
<![CDATA[XIC(VGR_start.2)OTE(Local:6:O.Data.28);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Test VGR Motor M2 horizontal axis forward]]>
</Comment>
<Text>
<![CDATA[XIC(VGR_start.3)OTE(Local:6:O.Data.29);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Test VGR  Motor M3 rotate clockwise
]]>
</Comment>
<Text>
<![CDATA[XIC(VGR_start.4)OTE(Local:6:O.Data.30);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Test VGR Motor M3 rotate counterclockwise
]]>
</Comment>
<Text>
<![CDATA[XIC(VGR_start.5)OTE(Local:6:O.Data.31);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Test VGR  Compressor]]>
</Comment>
<Text>
<![CDATA[XIC(VGR_start.6)OTE(Local:6:O.Data.12);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Test VGR Valve vacuum
]]>
</Comment>
<Text>
<![CDATA[XIC(VGR_start.7)OTE(Local:6:O.Data.13);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[[XIC(VGR_start.0) ,XIC(VGR_start.1) ]PWM_Out(VGR_PWM_Outputs[8],Local:7:O.Data.18,100,500);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[[XIC(VGR_start.2) ,XIC(VGR_start.3) ]PWM_Out(VGR_PWM_Outputs[9],Local:7:O.Data.19,100,500);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[[XIC(VGR_start.4) ,XIC(VGR_start.5) ]PWM_Out(VGR_PWM_Outputs[10],Local:7:O.Data.20,100,500);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="VGR_Sequencer" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[No activity on VGR]]>
</Comment>
<Text>
<![CDATA[EQ(VGR_Step,0)OTU(VGR_start.0)OTU(VGR_start.1)OTU(VGR_start.2)OTU(VGR_start.3)OTU(VGR_start.4)OTU(VGR_start.5)OTU(VGR_start.6)OTU(VGR_start.7)JMP(Done);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Reset VGR Encoders]]>
</Comment>
<Text>
<![CDATA[EQ(VGR_Step,10)JMP(VGR_Encoder_Reset);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Releases the vacuum in the VGR
]]>
</Comment>
<Text>
<![CDATA[EQ(VGR_Step,20)JMP(VGR_Disable_Vacuum);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Raise Arm for Rotation]]>
</Comment>
<Text>
<![CDATA[EQ(VGR_Step,30)MOVE(VGR_Move_Vertical,VGR_Vertical_Target)JMP(VGR_Raise_Arm_To);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Retract the Arm to avoid collision]]>
</Comment>
<Text>
<![CDATA[EQ(VGR_Step,40)MOVE(VGR_Move_Horizontal,VGR_Horizontal_Target)JMP(VGR_Extend_Arm_To);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Rotate the arm to the puck]]>
</Comment>
<Text>
<![CDATA[EQ(VGR_Step,50)MOVE(VGR_HBW_Rotate,VGR_Rotation_Target)JMP(VGR_Rotate_To);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Extend the arm over the puck]]>
</Comment>
<Text>
<![CDATA[EQ(VGR_Step,60)MOVE(VGR_HBW_Horizontal,VGR_Horizontal_Target)JMP(VGR_Extend_Arm_To);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Lower the arm onto the puck]]>
</Comment>
<Text>
<![CDATA[EQ(VGR_Step,70)MOVE(VGR_HBW_Vertical,VGR_Vertical_Target)JMP(VGR_Raise_Arm_To);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Enable vacuum to pick up the puck]]>
</Comment>
<Text>
<![CDATA[EQ(VGR_Step,80)JMP(VGR_Enable_Vacuum);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Raise arm up with puck]]>
</Comment>
<Text>
<![CDATA[EQ(VGR_Step,90)MOVE(VGR_Move_Vertical,VGR_Vertical_Target)JMP(VGR_Raise_Arm_To);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Retract the arm to avoid collision]]>
</Comment>
<Text>
<![CDATA[EQ(VGR_Step,100)MOVE(90,Step[19])MOVE(VGR_Move_Horizontal,VGR_Horizontal_Target)JMP(VGR_Extend_Arm_To);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Rotate to the Oven]]>
</Comment>
<Text>
<![CDATA[EQ(VGR_Step,110)MOVE(VGR_MPO_Rotate,VGR_Rotation_Target)JMP(VGR_Rotate_To);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Extend the arm over the oven]]>
</Comment>
<Text>
<![CDATA[EQ(VGR_Step,120)MOVE(VGR_MPO_Horizontal,VGR_Horizontal_Target)JMP(VGR_Extend_Arm_To);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Lower arm into the oven]]>
</Comment>
<Text>
<![CDATA[EQ(VGR_Step,130)MOVE(VGR_MPO_Vertical,VGR_Vertical_Target)JMP(VGR_Raise_Arm_To);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Release Puck And tell the MPO to start]]>
</Comment>
<Text>
<![CDATA[EQ(VGR_Step,140)OTL(MPO_Homing)OTL(MPO_Oven_Start)JMP(VGR_Disable_Vacuum);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Raise Arm]]>
</Comment>
<Text>
<![CDATA[EQ(VGR_Step,150)MOVE(VGR_Move_Vertical,VGR_Vertical_Target)JMP(VGR_Raise_Arm_To);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Extend the arm]]>
</Comment>
<Text>
<![CDATA[EQ(VGR_Step,160)MOVE(VGR_Move_Horizontal,VGR_Horizontal_Target)JMP(VGR_Extend_Arm_To);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Rotate the arm]]>
</Comment>
<Text>
<![CDATA[EQ(VGR_Step,170)MOVE(VGR_HBW_Rotate,VGR_Rotation_Target)JMP(VGR_Rotate_To);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Return if we didn't provide a valid step for the jump table
Return when done with a sequence.
]]>
</Comment>
<Text>
<![CDATA[LBL(Done)RET();]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[Homes all of the encoder values]]>
</Comment>
<Text>
<![CDATA[LBL(VGR_Encoder_Reset)XIO(Local:3:I.Data.7)OTU(VGR_start.5)OTL(VGR_start.4);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[XIC(Local:3:I.Data.7)RES(Encoder_Counters_1X[4])OTU(VGR_start.4);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[XIO(Local:3:I.Data.5)OTL(VGR_start.0);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[XIC(Local:3:I.Data.5)RES(Encoder_Counters_1X[2])OTU(VGR_start.0);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[XIO(Local:3:I.Data.6)OTL(VGR_start.2);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Text>
<![CDATA[XIC(Local:3:I.Data.6)RES(Encoder_Counters_1X[3])OTU(VGR_start.2);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Text>
<![CDATA[XIC(Local:3:I.Data.7)XIC(Local:3:I.Data.5)XIC(Local:3:I.Data.6)MOVE(0,VGR_Step);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Text>
<![CDATA[JMP(Done);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Comment>
<![CDATA[Turns off the vacuum gripper]]>
</Comment>
<Text>
<![CDATA[LBL(VGR_Disable_Vacuum)OTU(VGR_start.6)OTU(VGR_start.7);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Text>
<![CDATA[ADD(VGR_Step,10,VGR_Step)JMP(Done);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Comment>
<![CDATA[Turns on the vacuum gripper]]>
</Comment>
<Text>
<![CDATA[LBL(VGR_Enable_Vacuum)OTL(VGR_start.6)OTL(VGR_start.7);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Text>
<![CDATA[ADD(VGR_Step,10,VGR_Step)JMP(Done);]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Comment>
<![CDATA[Rotates the VGR to a certain encoder value]]>
</Comment>
<Text>
<![CDATA[LBL(VGR_Rotate_To)[GT(Encoder_Counters_1X[4].ACC,VGR_Rotation_Target) OTL(VGR_start.4) ,LT(Encoder_Counters_1X[4].ACC,VGR_Rotation_Target) OTL(VGR_start.5) ];]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Text>
<![CDATA[EQ(Encoder_Counters_1X[4].ACC,VGR_Rotation_Target)ADD(VGR_Step,10,VGR_Step)OTU(VGR_start.4)OTU(VGR_start.5);]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Text>
<![CDATA[JMP(Done);]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
<Comment>
<![CDATA[Raises the VGR to a certain encoder value]]>
</Comment>
<Text>
<![CDATA[LBL(VGR_Raise_Arm_To)[GT(Encoder_Counters_1X[2].ACC,VGR_Vertical_Target) OTL(VGR_start.0) ,LT(Encoder_Counters_1X[2].ACC,VGR_Vertical_Target) OTL(VGR_start.1) ];]]>
</Text>
</Rung>
<Rung Number="36" Type="N">
<Text>
<![CDATA[EQ(Encoder_Counters_1X[2].ACC,VGR_Vertical_Target)ADD(VGR_Step,10,VGR_Step)OTU(VGR_start.0)OTU(VGR_start.1);]]>
</Text>
</Rung>
<Rung Number="37" Type="N">
<Text>
<![CDATA[JMP(Done);]]>
</Text>
</Rung>
<Rung Number="38" Type="N">
<Comment>
<![CDATA[Extends the VGR to a certain encoder value]]>
</Comment>
<Text>
<![CDATA[LBL(VGR_Extend_Arm_To)[GT(Encoder_Counters_1X[3].ACC,VGR_Horizontal_Target) OTL(VGR_start.2) ,LT(Encoder_Counters_1X[3].ACC,VGR_Horizontal_Target) OTL(VGR_start.3) ];]]>
</Text>
</Rung>
<Rung Number="39" Type="N">
<Text>
<![CDATA[EQ(Encoder_Counters_1X[3].ACC,VGR_Horizontal_Target)ADD(VGR_Step,10,VGR_Step)OTU(VGR_start.2)OTU(VGR_start.3);]]>
</Text>
</Rung>
<Rung Number="40" Type="N">
<Text>
<![CDATA[JMP(Done);]]>
</Text>
</Rung>
<Rung Number="41" Type="N">
<Text>
<![CDATA[LBL(TIMED_MOTOR_ON)OTL(VGR_start.4);]]>
</Text>
</Rung>
<Rung Number="42" Type="N">
<Text>
<![CDATA[TON(StepTimers[3],?,?);]]>
</Text>
</Rung>
<Rung Number="43" Type="N">
<Text>
<![CDATA[XIC(StepTimers[3].DN)OTU(VGR_start.4)MOVE(0,VGR_Step)MOVE(0,StepTimers[3].ACC)RES(StepTimers[3]);]]>
</Text>
</Rung>
<Rung Number="44" Type="N">
<Text>
<![CDATA[JMP(Done);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
<Tasks>
<Task Name="MainTask" Type="CONTINUOUS" Priority="10" Watchdog="500" DisableUpdateOutputs="false" InhibitTask="false" SynchronizeRedundancyDataDisabled="false">
<ScheduledPrograms>
<ScheduledProgram Name="MainProgram"/>
</ScheduledPrograms>
</Task>
</Tasks>
<CST MasterID="0"/>
<WallClockTime LocalTimeAdjustment="0" TimeZone="0"/>
<Trends/>
<TimeSynchronize Priority1="128" Priority2="128" PTPEnable="true"/>
<EthernetPorts>
<EthernetPort Port="1" Label="1" PortEnabled="true"/>
</EthernetPorts>
<OpcUaInfo EnabledPorts=""/>
</Controller>
</RSLogix5000Content>
