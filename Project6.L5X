<![CDATA[XIC(Local:2:I.Data.13)[MOVE(50,Step[2]) ,OTU(Local:6:O.Data.21) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[JMP(Turntable_Idle);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[Turntable pusher extend]]>
</Comment>
<Text>
<![CDATA[LBL(Turntable_Pusher_On)OTL(Local:6:O.Data.9);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[TON(TurntableTimers[1],?,?);]]>
