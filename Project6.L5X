<Routine Name="Encoder_Values" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[HBW Encoder Section Start]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[HBW M2 Encoders First Scan Reset]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)RES(Encoder_Counters_4X[0]);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(S:FS)RES(Encoder_Counters_2X[0]);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(S:FS)RES(Encoder_Counters_1X[0]);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[HBW M2 Horizontal Positive(Toward Rack) Direction 4X]]>
</Comment>
<Text>
<![CDATA[XIC(Local:7:O.Data.12)XIC(Local:2:I.Data.8)[OSR(Encoder_Storage_Bits_HBW.0,Encoder_Output_Bits_HBW.0) ,OSF(Encoder_Storage_Bits_HBW.1,Encoder_Output_Bits_HBW.1) ]CTU(Encoder_Counters_4X[0],?,?);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Local:7:O.Data.12)XIC(Local:2:I.Data.9)[OSR(Encoder_Storage_Bits_HBW.2,Encoder_Output_Bits_HBW.2) ,OSF(Encoder_Storage_Bits_HBW.3,Encoder_Output_Bits_HBW.3) ]CTU(Encoder_Counters_4X[0],?,?);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[HBW M2 Horizontal Negative(Toward Belt) Direction 4X]]>
</Comment>
<Text>
<![CDATA[XIC(Local:7:O.Data.13)XIC(Local:2:I.Data.8)[OSR(Encoder_Storage_Bits_HBW.4,Encoder_Output_Bits_HBW.4) ,OSF(Encoder_Storage_Bits_HBW.5,Encoder_Output_Bits_HBW.5) ]CTD(Encoder_Counters_4X[0],?,?);]]>
</Text>
</Rung>
